# Kopiera till .env.local och fyll i. Inga riktiga värden i repot.

# Kanonisk bas-URL (canonical, OpenGraph, sitemap, robots). Rekommenderas i produktion/Vercel.
# Tom/ogiltig → fallback: VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL → http://localhost:3501
NEXT_PUBLIC_SITE_URL=https://berryit.se

# Mottagare för kontaktformuläret (multipart POST). Tom = formuläret svarar 503.
CONTACT_WEBHOOK_URL=

# --- BERRYiT Support Desk (separat Supabase-projekt) ------------------------
# Skapas av ägaren. Lägg aldrig riktiga värden i repot – använd .env.local och
# Vercels miljövariabler. Service role-nyckeln är hemlig och får ALDRIG
# exponeras i klienten eller i NEXT_PUBLIC_*-variabler.

# Projektets API-URL, t.ex. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publik anon-nyckel (säker i klienten – RLS skyddar datan)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role-nyckel. Endast server-side (API-routes/server actions).
# Kringgår RLS – används bara för administration, aldrig för kundtrafik.
SUPABASE_SERVICE_ROLE_KEY=

# Valfria uttryckliga browser-origins för Desktop-utvecklingens registreringsanrop.
# Native Desktop skickar Bearer utan Origin. Ingen jokertecken-CORS.
CONTROL_ALLOWED_ORIGINS=
