{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BERRYiT Control Center",
  "version": "0.1.2",
  "identifier": "se.berryit.controlcenter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3601",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BERRYiT Control Center",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "BERRYiT",
    "copyright": "© BERRYiT",
    "category": "Business",
    "shortDescription": "IT-support och administration",
    "longDescription": "BERRYiT Control Center – supportärenden, kunder och drift för BERRYiT:s egna projekt och externa kunder.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Swedish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
