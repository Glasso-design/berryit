{
  "name": "berryit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3501",
    "build": "node scripts/preview-guard.mjs && next build --webpack",
    "test:preview-guard": "node --test scripts/preview-guard.test.mjs",
    "start": "next start -p 3501",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "db:test": "node supabase/tests/run-local.mjs --environment=isolated-pglite",
    "db:upgrade-test": "node supabase/tests/upgrade-2c.mjs --environment=isolated-pglite",
    "db:master-upgrade-test": "node supabase/tests/master-upgrade.test.mjs --environment=isolated-pglite",
    "db:http-preflight": "node supabase/tests/http-preflight.mjs --environment=isolated-local-supabase",
    "db:safety-test": "node --test supabase/tests/isolated-environment.test.mjs",
    "db:repair-test": "node supabase/tests/security-repair.test.mjs --environment=isolated-pglite",
    "db:access-test": "node supabase/tests/project-access.test.mjs --environment=isolated-pglite",
    "test:project-access": "node tests/access/run.mjs --environment=isolated-pglite",
    "test:ai-diagnostics": "node tests/ai/run.mjs --environment=isolated-pglite",
    "test:support-workflow": "node tests/support/run.mjs --environment=isolated-pglite",
    "test:desktop-connection": "playwright test --config=tests/desktop/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
